{
  "name": "danceclub",
  "productName": "Клуб танцев",
  "version": "1.0.0",
  "description": "Приложение Клуба корпоративных бальных танцев для Windows",
  "author": "АНО «Клуб корпоративных спортивных бальных танцев»",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ru.corpdance.app",
    "productName": "Клуб танцев",
    "artifactName": "DanceClub-${version}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "build/icon.png"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Клуб танцев",
      "artifactName": "DanceClub-Setup.${ext}"
    },
    "portable": { "artifactName": "DanceClub-Portable.${ext}" }
  }
}
