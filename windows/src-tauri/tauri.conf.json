{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Клуб танцев",
  "mainBinaryName": "DanceClub",
  "version": "1.0.0",
  "identifier": "ru.corpdance.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Клуб корпоративных бальных танцев",
    "copyright": "corpdance.ru",
    "shortDescription": "Приложение клуба корпоративных бальных танцев",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
